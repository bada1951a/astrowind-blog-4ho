---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

// 4호기 대문 이미지 불러오기 (galaxy.png 적용)
import galaxyImg from '~/assets/images/galaxy.png';

const metadata = {
  title: 'Daily Prompt Hack — Advanced AI & Prompt Engineering Insights',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Explore Articles',
        href: '/blog',
        icon: 'tabler:chevron-right',
      },
    ]}
    image={{
      src: galaxyImg,
      alt: 'Daily Prompt Hack - AI Prompt Engineering Blueprints',
    }}
  >
    <Fragment slot="title">
      Advanced AI & Prompting Insights,<br />
      <span class="text-accent dark:text-white highlight">Daily Prompt Hack</span>
    </Fragment>

    <Fragment slot="subtitle">
      Actionable prompt engineering blueprints, LLM optimization workflows, and practical generative AI frameworks for creators and developers.
    </Fragment>
  </Hero>

  <!-- Latest Posts Section -->
  <BlogLatestPosts
    title="Latest Articles"
    information="Explore battle-tested prompt architectures and generative AI workflows."
    count={6}
  />
</Layout>
